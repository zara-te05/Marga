# Copia este archivo como .env (en la carpeta server/) y ajusta los valores.

# Cadena de conexión a PostgreSQL
MARGA_DB_URL=postgres://marga:marga@localhost:5432/marga?sslmode=disable

# Dirección donde escucha el servidor web
MARGA_ADDR=:8080

# Carpeta del front (index.html, pages/, assets/). Por defecto se detecta ".."
# MARGA_WEB_DIR=C:\Users\tu-usuario\Desktop\Marga Sun

# Duración de las sesiones y de los diffs en caché
MARGA_SESSION_TTL=72h
MARGA_DIFF_TTL=24h

# Pon true solo si sirves Marga detrás de HTTPS
MARGA_SECURE_COOKIE=false
