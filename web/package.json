{
  "name": "marga-web",
  "private": true,
  "description": "Solo para regenerar assets/css/marga.css con Tailwind",
  "scripts": {
    "css": "tailwindcss -c tailwind.config.js -i entrada.css -o assets/css/marga.css --minify",
    "css:vigilar": "tailwindcss -c tailwind.config.js -i entrada.css -o assets/css/marga.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.9",
    "tailwindcss": "3.4.17"
  }
}
