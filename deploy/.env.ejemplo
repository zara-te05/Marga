# Copia este archivo como deploy/.env y ajusta los valores. NO subas .env a git.

# Dominio con el que la gente abrirá Marga (debe apuntar a este servidor).
MARGA_DOMINIO=marga.tu-dominio.com

# Contraseña de PostgreSQL. Genera una larga, por ejemplo: openssl rand -base64 32
POSTGRES_PASSWORD=cambia-esto

# Versión de la imagen (latest o una etiqueta como 0.5.0)
MARGA_VERSION=latest

# Correo para "¿Olvidaste tu contraseña?". Si lo dejas vacío, el enlace aparece en
#   docker compose logs marga
# y un administrador también puede generarlo con:
#   docker compose exec marga /marga-server -restablecer persona@correo.com
MARGA_SMTP_HOST=
MARGA_SMTP_PUERTO=587
MARGA_SMTP_USUARIO=
MARGA_SMTP_PASSWORD=
MARGA_SMTP_DE=Marga <no-responder@tu-dominio.com>

# Días de respaldos que se conservan en deploy/respaldos/
RESPALDOS_DIAS=14
